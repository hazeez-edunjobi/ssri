# SSRI — SubSurface Risk Intelligence
# Copy to .env and adjust values. Never commit .env.

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=ssri
POSTGRES_USER=ssri
POSTGRES_PASSWORD=change_me

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Ports / frontend
# ------------------------------------------------------------------------------
API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# SSRI application (authoritative — model/ package)
# ------------------------------------------------------------------------------
SSRI_API_ENVIRONMENT=development
SSRI_API_HOST=0.0.0.0
SSRI_API_PORT=8000
SSRI_API_PREFIX=/api/v1
SSRI_API_OUTPUT_ROOT=/data/outputs
SSRI_API_SERVICE_NAME=ssri-inference
SSRI_API_SERVICE_VERSION=0.1.0

# local | distributed  (Compose defaults to distributed)
SSRI_EXECUTION_MODE=distributed
SSRI_DATABASE_URL=postgresql+psycopg://ssri:change_me@postgres:5432/ssri
SSRI_REDIS_URL=redis://redis:6379/0
SSRI_CELERY_BROKER_URL=redis://redis:6379/0
SSRI_CELERY_RESULT_BACKEND=redis://redis:6379/0
SSRI_CELERY_CONCURRENCY=1
SSRI_MAX_ATTEMPTS=3
SSRI_JOB_LEASE_SECONDS=300
SSRI_WORKER_HEARTBEAT_SECONDS=30
SSRI_LEASE_RECOVERY_ENABLED=false
SSRI_LEASE_RECOVERY_INTERVAL_SECONDS=60
SSRI_LEASE_RECOVERY_BATCH_SIZE=50
# Staging: start the recovery sweeper with
#   docker compose -f infra/docker-compose.yml -f infra/docker-compose.staging.yml up -d
# (recovery service sets SSRI_LEASE_RECOVERY_ENABLED=true). Production must schedule
# the same sweeper (Compose recovery service, cron, or k8s Job) — code alone is not enough.

# Domain similarity reference centroid (.npy of shape (13,)). Unset = uncalibrated.
# SSRI_DOMAIN_CENTROID_PATH=/data/reference/domain_centroid.npy

# Fixture checkpoints (dataset_manifest.name in {e2e,demo,fixture,test}):
# development: tagged is_fixture_checkpoint=true
# staging/production: refused unless SSRI_ALLOW_FIXTURE_CHECKPOINTS=true
SSRI_ALLOW_FIXTURE_CHECKPOINTS=false

# Auth (keep disabled only for local development)
SSRI_AUTH_ENABLED=false
SSRI_AUTH_DEVELOPMENT_MODE=true
SSRI_AUTH_KEY_STORE=/data/auth/keys.json
SSRI_AUTH_REQUIRE_IN_PRODUCTION=true

# Rate limiting
SSRI_RATE_LIMIT_ENABLED=false
SSRI_WORKER_COUNT=2

# Scientific policy
SSRI_API_SCIENTIFIC_VALIDATION_REQUIRED=false
SSRI_API_ALLOW_UNVALIDATED_PREDICTIONS=true
# When false (production default), client-supplied statuses are ignored.
SSRI_TRUST_CLIENT_SCIENTIFIC_STATUS=true

# ------------------------------------------------------------------------------
# Version 4 platform (Supabase). Public values may be exposed to the browser.
# Never put SUPABASE_SERVICE_ROLE_KEY in frontend env or NEXT_PUBLIC_*.
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

GOOGLE_APPLICATION_CREDENTIALS=
GEE_SERVICE_ACCOUNT=
GCP_PROJECT_ID=
OPENTOPOGRAPHY_API_KEY=
# Minimum OpenTopography request side length in meters (API rejects <~250 m).
SSRI_OPENTOPO_MIN_BBOX_SIDE_M=500
# Local geophysics GeoTIFFs (relative paths resolve against repo root / SSRI_REPO_ROOT)
# Docker Compose hardcodes container paths under /data/geophysics/ (do not pass Windows host paths).
SSRI_GRAVITY_SOURCE=wgm2012_bouguer
GRAVITY_DATA_PATH=data/geophysics/processed/lagos_gravity_wgm2012_bouguer.tif
MAGNETIC_DATA_PATH=data/geophysics/processed/lagos_magnetic_emag2v3_uc4km.tif
# PRD path (fail-closed; no silent WGM substitution):
# SSRI_GRAVITY_SOURCE=eigen6c4
# EIGEN6C4_DATA_PATH=data/geophysics/processed/eigen6c4_bouguer_<region>.tif
# Datasets on disk today: WGM2012 Complete Spherical Bouguer (mGal); EMAG2v3 UC 4km (nT).
# EIGEN-6C4: not yet acquired — see docs/EIGEN6C4_ACQUISITION.md
# Native resolution ~2 arc-min (regional); SSRI resamples to 30 m UTM without inventing signal.
# DEM: SSRI_DEM_PROVIDER=auto → OpenTopography first, GEE COP30 on rate-limit/unavailable.
SSRI_DEM_PROVIDER=auto

# Live AOI assessment (GEE + OpenTopography + local geophysics). Keep false unless credentials configured.
SSRI_LIVE_ACQUISITION_ENABLED=false

# Presentation-only assessments (server env). Default false — never use for science.
# When true, /api/v1/assess returns deterministic local responses and skips GEE/OpenTopo/geophysics.
SSRI_DEMO_MODE=false

# Earth Engine (canonical + aliases)
# GOOGLE_APPLICATION_CREDENTIALS=credentials/earth-engine.json
# GEE_PRIVATE_KEY_PATH=credentials/earth-engine.json
# GEE_SERVICE_ACCOUNT=your-sa@project.iam.gserviceaccount.com
# GCP_PROJECT_ID=your-gcp-project
# GEE_PROJECT=your-gcp-project

# CORS (comma-separated). Production must not use *.
# SSRI_CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Object storage: local | s3 | minio | r2
# For Compose + MinIO (--profile storage), use backend=s3/minio with:
#   SSRI_OBJECT_STORAGE_ENDPOINT=http://minio:9000  (inside containers)
#   SSRI_OBJECT_STORAGE_BUCKET=ssri-artifacts
# Host-side qualify scripts may use http://127.0.0.1:9000 instead.
SSRI_OBJECT_STORAGE_BACKEND=local
SSRI_OBJECT_STORAGE_ROOT=/data/outputs/objects
SSRI_OBJECT_STORAGE_BUCKET=
SSRI_OBJECT_STORAGE_ENDPOINT=
SSRI_OBJECT_STORAGE_REGION=us-east-1
SSRI_OBJECT_STORAGE_ACCESS_KEY=
SSRI_OBJECT_STORAGE_SECRET_KEY=
SSRI_OBJECT_STORAGE_URL_EXPIRES=3600
