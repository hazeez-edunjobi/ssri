# SSRI Frontend — copy to .env.local for local development

# Local API origin. Omit this on Vercel: production builds use
# https://ssri-api.onrender.com when NEXT_PUBLIC_API_URL is unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Presentation Assessment Preview UI (development only). Production builds
# ignore this and never show catalogue scenarios or fabricated scores.
# Requires server SSRI_DEMO_MODE=true in a development API environment.
# NEXT_PUBLIC_SSRI_ALLOW_PRESENTATION_DEMO=true
