# Copy into a Render Background Worker. Values must match the API service.
# Never commit real secrets.

SSRI_EXECUTION_MODE=distributed
SSRI_DATABASE_URL=
SSRI_REDIS_URL=
SSRI_CELERY_BROKER_URL=
SSRI_CELERY_RESULT_BACKEND=
SSRI_CELERY_CONCURRENCY=1
SSRI_API_OUTPUT_ROOT=/data/outputs
SSRI_API_ENVIRONMENT=production
LOG_LEVEL=info

# Auth / CORS / demo (must match API)
SSRI_AUTH_ENABLED=true
SSRI_AUTH_DEVELOPMENT_MODE=false
SSRI_DEMO_MODE=false
# SSRI_CORS_ORIGINS=https://your-frontend.example

# Durable object storage (required when API and worker do not share a disk)
SSRI_OBJECT_STORAGE_BACKEND=r2
SSRI_OBJECT_STORAGE_BUCKET=
SSRI_OBJECT_STORAGE_ENDPOINT=
SSRI_OBJECT_STORAGE_REGION=auto
SSRI_OBJECT_STORAGE_ACCESS_KEY=
SSRI_OBJECT_STORAGE_SECRET_KEY=
SSRI_REQUIRE_DURABLE_OBJECT_STORAGE=true

# Lease recovery (run a *separate* Background Worker with Docker command `recovery`)
# SSRI_LEASE_RECOVERY_ENABLED=true
# SSRI_LEASE_RECOVERY_INTERVAL_SECONDS=60
# SSRI_JOB_LEASE_SECONDS=300
# SSRI_WORKER_HEARTBEAT_SECONDS=30

# Acquisition paths as required by the jobs you run:
# SSRI_LIVE_ACQUISITION_ENABLED=
# GEE_PRIVATE_KEY_PATH=
SSRI_GRAVITY_SOURCE=wgm2012_bouguer
GRAVITY_DATA_PATH=/data/geophysics/processed/lagos_gravity_wgm2012_bouguer.tif
MAGNETIC_DATA_PATH=/data/geophysics/processed/lagos_magnetic_emag2v3_uc4km.tif
SSRI_DATA_ROOT=/data
