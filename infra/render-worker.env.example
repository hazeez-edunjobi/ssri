# Copy into a Render Background Worker. Values must match the API service.
# Never commit real secrets.

SSRI_EXECUTION_MODE=distributed
SSRI_DATABASE_URL=
SSRI_REDIS_URL=
SSRI_CELERY_BROKER_URL=
SSRI_CELERY_RESULT_BACKEND=
SSRI_CELERY_CONCURRENCY=1
SSRI_API_OUTPUT_ROOT=/data/outputs
SSRI_API_ENVIRONMENT=production
LOG_LEVEL=info

# Match API auth / storage / acquisition as required by the jobs you run:
# SSRI_AUTH_ENABLED=
# SSRI_OBJECT_STORAGE_BACKEND=
# SSRI_LIVE_ACQUISITION_ENABLED=
# GEE_PRIVATE_KEY_PATH=
# GRAVITY_DATA_PATH=
